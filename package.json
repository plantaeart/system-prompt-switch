{
  "name": "system-prompt-switch",
  "version": "0.10.0",
  "description": "Pi extension to manage custom system prompts per session with switch, modal selection, and CRUD commands",
  "type": "module",
  "main": "extensions/index.ts",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "./assets/imgs/img1.png"
  },
  "extensions": [
    "./extensions"
  ],
  "scripts": {
    "test": "bun run test:pi && bun run test:omp",
    "test:pi": "OMPCODE=0 bun test",
    "test:omp": "OMPCODE=1 bun test",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "validate:skills": "bash .agents/skills/ci-check/scripts/validate-skills.sh",
    "ci": "bun run lint && bun run typecheck && bun test && bun run validate:skills"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "bun-types": "^1.4.2",
    "oxlint": "^1.85.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
