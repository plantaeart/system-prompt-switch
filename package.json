{
  "name": "system-prompt-switch",
  "version": "0.14.0",
  "description": "Pi and OMP extension to manage custom system prompts per session: switch, stack, and edit prompts from a modal, with CRUD slash commands",
  "type": "module",
  "main": "extensions/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "omp",
    "oh-my-pi",
    "system-prompt",
    "prompt-manager",
    "custom-instructions"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/plantaeart/system-prompt-switch/master/assets/logo/cover.png"
  },
  "extensions": [
    "./extensions"
  ],
  "scripts": {
    "test": "bun run test:pi && bun run test:omp",
    "test:pi": "OMPCODE=0 bun test",
    "test:omp": "OMPCODE=1 bun test",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "validate:skills": "bash .agents/skills/ci-check/scripts/validate-skills.sh",
    "ci": "bun run lint && bun run typecheck && bun test && bun run validate:skills"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "bun-types": "^1.4.2",
    "oxlint": "^1.85.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plantaeart/system-prompt-switch.git"
  },
  "homepage": "https://github.com/plantaeart/system-prompt-switch#readme",
  "bugs": {
    "url": "https://github.com/plantaeart/system-prompt-switch/issues"
  }
}
